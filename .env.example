# Variables de entorno de Grit.
# Copiá este archivo a `.env.local` para desarrollo. En producción se cargan
# desde el panel de Vercel (Project → Settings → Environment Variables).
#
# Las que empiezan con NEXT_PUBLIC_ viajan al navegador: nunca pongas un
# secreto ahí.

# ------------------------------------------------------------------
# Meta Pixel
# ------------------------------------------------------------------
# Pixel ID de Meta Events Manager. Opcional: si no está definida, el sitio usa
# el mismo ID por defecto que está en lib/meta-pixel.ts. Configurala en Vercel
# para poder cambiar de pixel sin tocar el código.
NEXT_PUBLIC_META_PIXEL_ID=2195171668070768

# ------------------------------------------------------------------
# Meta Conversions API — Purchase de pedidos MANUALES (panel /admin)
# ------------------------------------------------------------------
# Solo servidor. El botón "Enviar venta a Meta" del detalle de un pedido
# manual y pagado manda un Purchase server-side (action_source "chat").
# Los pedidos web NO pasan por acá: los reporta el Pixel y la integración
# "Conversions API with Meta" de Events Manager.
#
# Token de Conversions API del dataset. SECRETO: nunca con NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=
# ID del dataset de Events Manager (el mismo número que el Pixel). Opcional:
# si falta, se usa NEXT_PUBLIC_META_PIXEL_ID.
META_DATASET_ID=
# Solo en Preview: con este código, todo envío sale como Test Event y no
# cuenta en Meta. Sin él, el envío real solo se permite en producción.
META_CAPI_TEST_EVENT_CODE=
# Opcional. Versión de Graph API (por defecto v26.0).
META_GRAPH_API_VERSION=

# ------------------------------------------------------------------
# Supabase (checkout, pedidos y panel de administración)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Secreta: solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------
# Aviso de pedidos por Telegram (opcional)
# ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
