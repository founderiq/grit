# Variables de entorno de Grit.
# Copiá este archivo a `.env.local` para desarrollo. En producción se cargan
# desde el panel de Vercel (Project → Settings → Environment Variables).
#
# Las que empiezan con NEXT_PUBLIC_ viajan al navegador: nunca pongas un
# secreto ahí.

# ------------------------------------------------------------------
# Meta Pixel
# ------------------------------------------------------------------
# Pixel ID de Meta Events Manager. Opcional: si no está definida, el sitio usa
# el mismo ID por defecto que está en lib/meta-pixel.ts. Configurala en Vercel
# para poder cambiar de pixel sin tocar el código.
NEXT_PUBLIC_META_PIXEL_ID=2195171668070768

# ------------------------------------------------------------------
# Supabase (checkout, pedidos y panel de administración)
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Secreta: solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------
# Aviso de pedidos por Telegram (opcional)
# ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
